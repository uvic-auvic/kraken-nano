":{"language":"Python"},"content":[{"type":"text","marks":[{"type":"author_id","attrs":{"authorId":"36383516852"}}],"text":"pip install ultralytics"}]},{"type":"paragraph"},{"type":"paragraph","content":[{"type":"text","marks":[{"type":"author_id","attrs":{"authorId":"36383516852"}}],"text":"Then models can be run and interpreted as seen below:"}]},{"type":"code_block","attrs":{"language":"Python"},"content":[{"type":"text","marks":[{"type":"author_id","attrs":{"authorId":"36383516852"}}],"text":"from ultralytics import YOLO\n\nmodel = YOLO(\"arvp_f.pt\")\nresults = model(image)[0]\ndetections = results.boxes\n\n# get a tensor of the location of detections: size = (# of detections, 4)\ndetection_loacations = detectins.xywh \n\n# get a tensor of the confidence scores of detections: size = (# of detections)\ndetection_confidence = detections.conf\n\n# get a tensor of class IDs of the detection: size = (# of detections)\ndetection_IDs = detections.id\n\n# detection_loacations[i], detection_confidence[i] \n# and detection_IDs[i] all corespond to the same detection\n"}]},{"type":"paragraph"},{"type":"paragraph","content":[{"type":"text","marks":[{"type":"author_id","attrs":{"authorId":"36383516852"}}],"text":"For more information see ultralytics docs: "},{"type":"text","marks":[{"type":"link","attrs":{"href":"https://docs.ultralytics.com/"}},{"type":"author_id","attrs":{"authorId":"36383516852"}}],"text":"https://docs.ultralytics.com/"}]}]},"savepoint_metadata":{"savepointFileId":null,"savepointsInfo":{},"shouldCreateSavepointBeforeApplyingNextVersion":false,"authorsSinceLastSavepoint":{"36383516852":true},"allAuthorNames":{"36383516852":"Aryan Aryal"}},"last_edit_timestamp":1754973163996}